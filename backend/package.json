{
  "name": "military-asset-management-backend",
  "version": "1.0.0",
  "description": "Backend API for Military Asset Management System",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "npx prisma migrate dev",
